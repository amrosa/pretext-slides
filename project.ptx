<?xml version="1.0" encoding="utf-8"?>
<!-- This file, the project manifest, provides the overall configuration for your PreTeXt project. To edit the content of your document, open `source/main.ptx`. See https://pretextbook.org/doc/guide/html/processing-CLI.html#cli-project-manifest. -->
<project ptx-version="2">
  <targets>
    <target
        name="Day 1 Slides"
        source="slides-01.ptx"
        format="revealjs"
        output-filename="index.html"
        deploy-dir="slides"
        />
    <target
        name="Day 2 Slides"
        source="slides-02.ptx"
        format="revealjs"
        output-filename="index.html"
        deploy-dir="slides"
        />
    <target
        name="slides-annotated"
        format="revealjs"
        output-filename="index-annotated.html"
        publication="publication_annotated.ptx"
        deploy-dir="slides-annotated"
        />
  </targets>
</project>
